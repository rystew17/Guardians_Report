# Copy to .env and fill in. .env is gitignored.
GCP_PROJECT=your-gcp-project-id
BQ_DATASET=guards_report
BQ_LOCATION=US

# Cost guardrail: every query job is capped at this many bytes billed.
# 1 GiB is ~100x a normal daily run; a runaway query fails instead of billing.
BQ_MAX_BYTES_BILLED=1073741824

# Where gzipped raw API payloads are archived (provenance).
RAW_ARCHIVE_DIR=data/raw
